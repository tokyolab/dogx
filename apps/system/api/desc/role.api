import "base.api"

type (
	RoleListReq {
		Page     int64  `json:"page"`
		PageSize int64  `json:"pageSize"`
		Keyword  string `json:"keyword,optional"`
	}

	RoleItem {
		Id          int64  `json:"id"`
		Code        string `json:"code"`
		Name        string `json:"name"`
		Description string `json:"description"`
		Sort        int64  `json:"sort"`
		Status      int64  `json:"status"`
		IsSystem    bool   `json:"isSystem"`
		CreatedAt   string `json:"createdAt"`
		UpdatedAt   string `json:"updatedAt"`
	}

	CreateRoleReq {
		Code        string `json:"code"`
		Name        string `json:"name"`
		Description string `json:"description,optional"`
		Sort        int64  `json:"sort"`
		Status      int64  `json:"status"`
	}

	CreateRoleResp {
		Id int64 `json:"id"`
	}

	UpdateRoleReq {
		Id          int64  `json:"id"`
		Code        string `json:"code"`
		Name        string `json:"name"`
		Description string `json:"description,optional"`
		Sort        int64  `json:"sort"`
	}

	UpdateRoleStatusReq {
		Id     int64 `json:"id"`
		Status int64 `json:"status"`
	}

	RoleListResp {
		Items []RoleItem `json:"items"`
		Total int64      `json:"total"`
	}

	GetRoleAPIsReq {
		RoleId int64 `json:"roleId"`
	}

	GetRoleAPIsResp {
		ApiIds []int64 `json:"apiIds"`
	}

	UpdateRoleAPIsReq {
		RoleId int64   `json:"roleId"`
		ApiIds []int64 `json:"apiIds"`
	}
)

@server (
	group:      role
	jwt:        Auth
	middleware: SessionAuth, Authorization
)
service system-api {
	@doc "Create a role"
	@handler createRole
	post /role/create (CreateRoleReq) returns (CreateRoleResp)

	@doc "List roles"
	@handler listRoles
	post /role/list (RoleListReq) returns (RoleListResp)

	@doc "Get a role"
	@handler getRole
	post /role/get (IDReq) returns (RoleItem)

	@doc "Update role metadata"
	@handler updateRole
	post /role/update (UpdateRoleReq) returns (EmptyResp)

	@doc "Enable or disable a role"
	@handler updateRoleStatus
	post /role/status/update (UpdateRoleStatusReq) returns (EmptyResp)

	@doc "Delete a role"
	@handler deleteRole
	post /role/delete (IDReq) returns (EmptyResp)

	@doc "Get API authorizations assigned to a role"
	@handler getRoleAPIs
	post /role/api/get (GetRoleAPIsReq) returns (GetRoleAPIsResp)

	@doc "Replace the complete API authorization set for a role"
	@handler updateRoleAPIs
	post /role/api/update (UpdateRoleAPIsReq) returns (EmptyResp)
}
