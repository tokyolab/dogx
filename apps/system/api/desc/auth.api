import "base.api"

type (
	LoginReq {
		Username string `json:"username" validate:"required,max=64"`
		Password string `json:"password" validate:"required,max=128"`
	}

	LoginResp {
		AccessToken  string `json:"accessToken"`
		RefreshToken string `json:"refreshToken"`
		ExpiresIn    int64  `json:"expiresIn"`
	}

	RefreshTokenReq {
		RefreshToken string `json:"refreshToken" validate:"required,max=256"`
	}

	ChangePasswordReq {
		CurrentPassword string `json:"currentPassword" validate:"required,max=128"`
		NewPassword     string `json:"newPassword" validate:"required,min=12,max=128"`
	}

	CurrentUserResp {
		Id       int64  `json:"id"`
		Username string `json:"username"`
		Nickname string `json:"nickname"`
	}
)

@server (
	group: auth
)
service system-api {
	@doc "Sign in with username and password"
	@handler login
	post /auth/login (LoginReq) returns (LoginResp)

	@doc "Rotate the refresh token and issue new credentials"
	@handler refreshToken
	post /auth/refresh (RefreshTokenReq) returns (LoginResp)
}

@server (
	group:      auth
	jwt:        Auth
	middleware: SessionAuth
)
service system-api {
	@doc "Return the current signed-in user"
	@handler currentUser
	post /auth/me returns (CurrentUserResp)

	@doc "Revoke the current session"
	@handler logout
	post /auth/logout returns (EmptyResp)

	@doc "Revoke all sessions of the current user"
	@handler logoutAll
	post /auth/logout-all returns (EmptyResp)

	@doc "Change the current user password and revoke all sessions"
	@handler changePassword
	post /auth/change-password (ChangePasswordReq) returns (EmptyResp)
}
